{
  "name": "mitaka",
  "version": "0.0.0",
  "description": "A browser extension for searching IP, domain, URL, hash, etc. via the context menu.",
  "license": "MIT",
  "author": "ninoseki",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninoseki/mitaka.git"
  },
  "type": "module",
  "scripts": {
    "build:firefox": "run-s build -- --mv3 -b firefox",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "wxt build",
    "type-check": "vue-tsc --build",
    "dev:firefox": "wxt -b firefox",
    "dev": "wxt",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "postinstall": "wxt prepare",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@github/mini-throttle": "^2.1.1",
    "@webext-core/messaging": "^4.0.1",
    "ioc-extractor": "^8.2.0",
    "js-base64": "^3.9.6",
    "js-sha256": "^1.0.0",
    "just-truncate": "^2.2.0",
    "neverthrow": "8.2.0",
    "valibot": "^1.5.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@ninoseki/eslint-plugin-neverthrow": "^0.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.1.43",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "coveralls": "3.1.1",
    "daisyui": "^5.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  },
  "lint-staged": {
    "*.ts": [
      "npx oxlint --fix",
      "npx oxfmt"
    ]
  }
}
